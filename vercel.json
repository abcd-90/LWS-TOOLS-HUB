    { "src": "/tools", "dest": "/tools/index.html" },
    { "src": "/contact/(.*)", "dest": "/contact/index.html" },
    { "src": "/contact", "dest": "/contact/index.html" },
    { "src": "/cart/(.*)", "dest": "/cart/index.html" },
    { "src": "/cart", "dest": "/cart/index.html" },
    { "src": "/auth/(.*)", "dest": "/auth/index.html" },
    { "src": "/auth", "dest": "/auth/index.html" },
    { "src": "/dashboard/(.*)", "dest": "/dashboard/index.html" },
    { "src": "/dashboard", "dest": "/dashboard/index.html" },
    { "src": "/lws-control-726/(.*)", "dest": "/lws-control-726/index.html" },
    { "src": "/lws-control-726", "dest": "/lws-control-726/index.html" },
